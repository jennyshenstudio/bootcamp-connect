# Shared editor settings: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.py]
indent_size = 4

# Generated or third-party files: leave as they are
[{css/tailwind.css,legacy/prototype-v1/css/tailwind.css,vendor/**}]
insert_final_newline = unset
trim_trailing_whitespace = unset
